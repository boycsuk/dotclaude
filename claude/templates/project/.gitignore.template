.DS_Store
Thumbs.db
*.swp
*.swo

# Environment files (must never be committed)
.env
.env.*
!.env.example

# Secrets directories
secrets/
credentials/

# codebase-memory-mcp repo snapshot (only written with its persistence: true; the index lives in ~/.cache)
.codebase-memory/
