# Application mode. Drives scripts/deploy.sh behavior.
# Allowed values: development | production
# - development: docker compose up --build --watch (hot reload, foreground)
# - production:  docker compose up -d --build       (detached, no watch)
APP_MODE=development

# Server
PORT=3000

# Database
# When backend runs on the host:    postgres://app:app@localhost:5432/app
# When backend runs in compose net:  postgres://app:app@db:5432/app
DATABASE_URL=postgres://app:app@localhost:5432/app

# Secrets — generate a unique value per environment with: openssl rand -hex 32
# NEVER ship this placeholder to production: a known SESSION_SECRET lets anyone
# forge sessions. Set a fresh random value in each deployment's own .env.
SESSION_SECRET=change-me-locally

# Third-party APIs (uncomment as needed)
# OPENAI_API_KEY=
# STRIPE_SECRET_KEY=
