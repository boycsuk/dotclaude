$cmd = if ($args.Count -ge 1) { $args[0] } else { "start" }
switch ($cmd) {
    "start"   { Start-App }
    "stop"    { Stop-App }
    "restart" { Restart-App }
    "logs"    { Show-Logs }
    default   { Write-Error "Usage: deploy.ps1 {start|stop|restart|logs}"; exit 1 }
}
