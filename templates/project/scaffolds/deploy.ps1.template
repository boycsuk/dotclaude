# Project lifecycle script — SKELETON (Windows, lockstep sibling of deploy.sh).
# The structure is wired up; you fill in the bodies for how THIS project
# starts/stops/logs. Keep the four subcommands.
#
#   .\deploy.ps1 start    bring the app up
#   .\deploy.ps1 stop     bring it down
#   .\deploy.ps1 restart  stop, then start
#   .\deploy.ps1 logs     follow logs (Ctrl-C to exit)
#
# APP_MODE from .env (development | production) is read for you so `start` can
# behave differently per environment. Fill in the functions with real commands.

$ErrorActionPreference = "Stop"
Set-Location $PSScriptRoot

if (-not (Test-Path ".env")) {
    Write-Error ".env not found. Copy .env.example to .env and adjust APP_MODE."
    exit 1
}

# Read APP_MODE without dot-sourcing .env.
$AppMode = "development"
$line = Select-String -Path ".env" -Pattern '^APP_MODE=' | Select-Object -First 1
if ($line) {
    $AppMode = ($line.Line -replace '^APP_MODE=', '').Trim().Trim('"').Trim("'")
    if (-not $AppMode) { $AppMode = "development" }
}

