#!/usr/bin/env bash
# Project lifecycle script — SKELETON. The structure is wired up; you fill in
# the bodies for how THIS project starts/stops/logs. Keep the four subcommands.
#
#   ./deploy.sh start    bring the app up
#   ./deploy.sh stop     bring it down
#   ./deploy.sh restart  stop, then start
#   ./deploy.sh logs     follow logs (Ctrl-C to exit)
#
# APP_MODE in .env is read for you (development | production) so `start` can
# behave differently per environment. Fill in the functions below with your
# real commands — examples are commented out for the common cases.

set -euo pipefail

cd "$(dirname "$0")"

if [ ! -f .env ]; then
  echo "ERROR: .env not found. Copy .env.example to .env and adjust APP_MODE." >&2
  exit 1
fi

# Read APP_MODE without sourcing .env (avoids executing shell metacharacters in
# values). Falls back to 'development' if absent or commented out.
APP_MODE="$(grep -E '^APP_MODE=' .env | head -n1 | cut -d= -f2- | tr -d '"' | tr -d "'")"
APP_MODE="${APP_MODE:-development}"

