  #   if [ "$APP_MODE" = "production" ]; then docker compose up -d --build
  #   else docker compose up --build --watch; fi
  #
  #   # Node process:           npm run start
  #   # Python process:         uv run python -m backend
  #   # Compiled binary:        ./bin/app
  #   # systemd service:        sudo systemctl start my-app
  echo "TODO: implement start() in deploy.sh (APP_MODE=$APP_MODE)" >&2
  exit 1
}

stop() {
  # TODO: bring the app down. Examples:
  #   docker compose down            # Docker
  #   pkill -f 'node .*backend'      # process (or use a PID file)
  #   sudo systemctl stop my-app     # systemd
  echo "TODO: implement stop() in deploy.sh" >&2
  exit 1
}

restart() {
  stop
  start
}

logs() {
  # TODO: follow the app's logs. Examples:
  #   docker compose logs -f --tail=100      # Docker
  #   tail -f ./logs/app.log                 # logfile
  #   journalctl -u my-app -f                # systemd
  echo "TODO: implement logs() in deploy.sh" >&2
  exit 1
}

CMD="${1:-start}"
case "$CMD" in
  start)   start ;;
  stop)    stop ;;
  restart) restart ;;
  logs)    logs ;;
  *)       echo "Usage: $0 {start|stop|restart|logs}" >&2; exit 1 ;;
esac
