{
  "_comment": "CENTRAL settings, installed to ~/.claude/settings.json by install.sh/ps1. Hook commands point at $HOME/.claude/hooks and every hook is one Python file run through python3; install.ps1 points python3 at the interpreter it verified on Windows (\"shell\": \"powershell\"), and adds a PowerShell(...) twin next to each Bash permission rule. These apply to EVERY project automatically; a project's own .claude/settings.json only adds to this (permissions and hooks merge across scopes). MODEL: Bash runs allow-by-default; the deny list + guard-destructive hook (which now matches ALL Bash) are the safety net. See DESIGN.md §9. PERMISSION MODE: defaultMode is \"auto\" (classifier-reviewed), making explicit what is already the built-in default on Pro/Max/Team rather than inheriting it silently — §9's model was reasoned when the default was Manual. Deny rules still block in every mode and ask rules still prompt, so the safety net is unchanged. NOTE: \"auto\" only takes effect from ~/.claude/settings.json — set in a PROJECT's .claude/settings.json it is ignored and the session starts in Manual, so never copy this key into the per-project stub. HOOK GATING: hook entries carry NO \"if\" conditions on purpose — an \"if\" pattern is prefix-anchored and reopens exactly the wrapped-form bypasses the hooks' own parsers close (\"if\": \"Bash(git push *)\" let `git -C /repo push origin main` through unjudged); every hook self-gates precisely and exits 0 fast on non-matches.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Bash"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git commit *--amend*)",
      "Bash(git filter-branch:*)",
      "Bash(npm install:*)",
      "Bash(pnpm install:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Bash(cargo add:*)",
      "Bash(go get:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(chgrp:*)",
      "Read(//**/.env.*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(sudo:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shred:*)",
      "Bash(truncate:*)",
      "Bash(mkfs.*)",
      "Bash(eval:*)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.test)",
      "Read(//**/.env.staging)",
      "Read(//**/secrets/**)",
      "Read(//**/credentials/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.git-credentials)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.azure/**)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/id_rsa)",
      "Read(//**/id_ed25519)",
      "Read(//**/id_ecdsa)"
    ],
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "auto"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "_seeded_comment": "outputStyle and fileCheckpointingEnabled are SEEDED, not owned: the installers write them only when the key is absent, so /config can change them and a re-install will not revert it. Adding a key here without adding it to SEEDED in install.sh AND $seeded in install.ps1 is caught by check.py.",
  "outputStyle": "dotclaude",
  "fileCheckpointingEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "python3 \"$HOME\"/.claude/hooks/statusline.py",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/guard-destructive.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/guard-push-main.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/guard-commit.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/guard-dependencies.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/guard-readonly-agents.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/guard-central-config.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/guard-dependencies.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/explore-graph-prompt.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/verify-on-edit.py",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/sync-mirror-docs.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/design-sync.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/detect-secrets.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/comment-hygiene.py",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/turn-end-notice.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/reinject-rules.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/code-intel-context.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "Plan|general-purpose|researcher|debugger|code-reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME\"/.claude/hooks/code-intel-context.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
